# ==============================================================================
# VARIABLES
# ==============================================================================

# Final executable name
TARGET = calc_compiler

# Output directory (executable and object files)
BUILD_DIR = build

# Source directories
SRC_DIR = src
LEXER_DIR = src/lexer
PARSER_DIR = src/parser

# Automatically find all .c files in src and its subdirectories
SRC_C = $(shell find $(SRC_DIR) -name '*.c')
# Object files for manual compilation
OBJ_C = $(SRC_C:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)

# Input files for tools (Flex and Bison)
FLEX_INPUT = $(LEXER_DIR)/scanner.l
BISON_INPUT = $(PARSER_DIR)/parser.y

# C files generated by Flex and Bison
GEN_C = $(BUILD_DIR)/parser.tab.c $(BUILD_DIR)/lex.yy.c
GEN_OBJ = $(GEN_C:.c=.o)

# Header files that must be visible to the compiler
INCLUDE_DIRS = -Iinclude

# Compiler flags (warnings, optimization, etc.)
CFLAGS = -Wall -g $(INCLUDE_DIRS)
LDFLAGS = -lm

# ==============================================================================
# TEST VARIABLES
# ==============================================================================

# Expected extension for test files
TEST_EXT = .cl
# List of all test files in the 'tests/' directory
TEST_FILES = $(wildcard tests/*$(TEST_EXT))

LOGS_FILE = "logs/compiler.log"

# ==============================================================================
# MAIN RULES
# ==============================================================================

.PHONY: all clean

# Default rule: generates all files and compiles
all: $(BUILD_DIR) $(BUILD_DIR)/$(TARGET)

# Creates the 'build' directory structure if it doesn't exist
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)
	@# Create the same directory structure as src in build
	@find $(SRC_DIR) -type d -exec mkdir -p $(BUILD_DIR)/{} \;

# Rule to build the final executable
$(BUILD_DIR)/$(TARGET): $(OBJ_C) $(GEN_OBJ)
	# Linking all object files (manual and generated)
	gcc $(CFLAGS) $^ -o $@ $(LDFLAGS)

# Rule to compile generated C files (Flex/Bison)
$(BUILD_DIR)/%.o: %.c
	# Compiling generated code: $<
	mkdir -p $(dir $@)
	gcc $(CFLAGS) -c $< -o $@

# Rule to compile manual C files
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	# Compiling source code: $<
	mkdir -p $(dir $@)
	gcc $(CFLAGS) -c $< -o $@

# ==============================================================================
# CODE GENERATION (Flex and Bison)
# ==============================================================================

# Rule for Flex: generates the C lexer (.c)
$(BUILD_DIR)/lex.yy.c: $(FLEX_INPUT) $(BUILD_DIR)/parser.tab.h
	flex -o $@ $<

# Rule for Bison: generates the C parser (.c) and the header file (.h)
$(BUILD_DIR)/parser.tab.c $(BUILD_DIR)/parser.tab.h: $(BISON_INPUT)
	bison -d $< -o $(BUILD_DIR)/parser.tab.c -Wcounterexamples
	cp $(BUILD_DIR)/parser.tab.h include/parser.h

# ==============================================================================
# DEPENDENCIES
# ==============================================================================

# Ensure generated headers are available before compiling some sources
$(OBJ_C): $(BUILD_DIR)/parser.tab.h

# ==============================================================================
# CLEANUP
# ==============================================================================

# Deletes all generated and compiled files
clean:
	rm -rf $(BUILD_DIR)
	rm -f include/parser.h

# ==============================================================================
# TEST AND EXECUTION RULES
# ==============================================================================

.PHONY: test run_one

# 1. Main rule: Iterates over all found test files.
test: $(BUILD_DIR)/$(TARGET)
	@echo "=================================================="
	@echo "  STARTING COMPILER TESTS ON $(TEST_FILES)"
	@echo "=================================================="
	@for file in $(TEST_FILES); do \
		echo "--- Processing: $$file ---"; \
		$(BUILD_DIR)/$(TARGET) $$file $(LOGS_FILE); \
		echo ""; \
	done
	@echo "=================================================="
	@echo "  TESTS FINISHED."
	@echo "=================================================="

# 2. Simple rule to execute a single specific test file.
# Usage: make run_one FILE=tests/programa1.cl
run_one: $(BUILD_DIR)/$(TARGET)
	@if [ -z "$(FILE)" ]; then \
		echo "ERROR: You must specify the input file. Usage: make run_one FILE=tests/archivo$(TEST_EXT)"; \
	else \
		echo "--- Executing $(TARGET) with file: $(FILE) ---"; \
		$(BUILD_DIR)/$(TARGET) $(FILE) $(LOGS_FILE); \
	fi

# ==============================================================================
# DEBUG RULES
# ==============================================================================

.PHONY: debug_sources debug_objects

# Debug rule to see found source files
debug_sources:
	@echo "Source files found:"
	@echo "$(SRC_C)"

# Debug rule to see object file targets
debug_objects:
	@echo "Object files to create:"
	@echo "$(OBJ_C)"